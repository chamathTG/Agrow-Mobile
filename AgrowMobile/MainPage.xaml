<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgrowMobile.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- TOP GREEN HEADER -->
            <Border StrokeShape="RoundRectangle 0,0,40,40"
                    BackgroundColor="#228B22"
                    HeightRequest="240">

                <VerticalStackLayout Padding="25,60,25,20"
                                     Spacing="15">

                    <!-- LOGO -->
                    <Image Source="logo_mobile.png" 
                           HeightRequest="80"
                           HorizontalOptions="Center"/>

                    <!-- TITLE -->
                    <Label Text="Welcome Back"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <Label Text="Login to continue"
                           TextColor="#E6E6E6"
                           FontSize="14"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Border>

            <!-- LOGIN FORM -->
            <VerticalStackLayout Padding="25,30,25,30"
                                 Spacing="18">

                <!-- LOGIN AS DROPDOWN -->
                <Label Text="Login As"
                       FontAttributes="Bold"
                       TextColor="#111111"/>

                <Frame BorderColor="#DDDDDD"
                       CornerRadius="15"
                       Padding="5"
                       HasShadow="False">

                    <Picker x:Name="LoginAsPicker"
                            Title="Select role"
                            FontSize="15">
                        <Picker.Items>
                            <x:String>Customer</x:String>
                            <x:String>Farmer</x:String>
                        </Picker.Items>
                    </Picker>

                </Frame>

                <!-- USERNAME -->
                <Label Text="Username"
                       FontAttributes="Bold"/>

                <Frame BorderColor="#DDDDDD"
                       CornerRadius="15"
                       Padding="10"
                       HasShadow="False">

                    <Entry Placeholder="Enter username"
                           BackgroundColor="Transparent"/>
                </Frame>

                <!-- PASSWORD -->
                <Label Text="Password"
                       FontAttributes="Bold"/>

                <Frame BorderColor="#DDDDDD"
                       CornerRadius="15"
                       Padding="10"
                       HasShadow="False">

                    <Entry Placeholder="Enter password"
                           IsPassword="True"
                           BackgroundColor="Transparent"/>
                </Frame>

                <Label Text="Forgot Password?"
                       TextColor="#228B22"
                       FontAttributes="Bold"
                       HorizontalOptions="End">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                    </Label.GestureRecognizers>

                </Label>

                <!-- LOGIN BUTTON -->
                <Button Text="Login"
                        HeightRequest="55"
                        BackgroundColor="#228B22"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="15"/>

                <!-- FOOTER -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="5">

                    <Label Text="Don't have an account?"
                           TextColor="Gray"/>

                    <Label Text="Create Account"
                           TextColor="#228B22"
                           FontAttributes="Bold">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateAccountTapped"/>
                        </Label.GestureRecognizers>

                    </Label>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>