<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgrowMobile.SignupPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- TOP HEADER -->
            <Border StrokeShape="RoundRectangle 0,0,40,40"
                    BackgroundColor="#228B22"
                    HeightRequest="220">

                <VerticalStackLayout Padding="25,60,25,20"
                                     Spacing="10">

                    <Image Source="logo_mobile.png"
                           HeightRequest="70"
                           HorizontalOptions="Center"/>

                    <Label Text="Create Account"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>

                    <Label Text="Sign up to continue"
                           FontSize="14"
                           TextColor="#EEEEEE"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Border>

            <!-- FORM -->
            <VerticalStackLayout Padding="25,30"
                                 Spacing="18">

                <!-- MOBILE -->
                <Label Text="Mobile Number"
                       FontAttributes="Bold"/>

                <Frame BorderColor="#DDDDDD"
                       CornerRadius="15"
                       Padding="10"
                       HasShadow="False">

                    <Entry Placeholder="Enter mobile number"
                           Keyboard="Telephone"
                           BackgroundColor="Transparent"/>
                </Frame>

                <!-- USERNAME -->
                <Label Text="Username"
                       FontAttributes="Bold"/>

                <Frame BorderColor="#DDDDDD"
                       CornerRadius="15"
                       Padding="10"
                       HasShadow="False">

                    <Entry Placeholder="Enter username"
                           BackgroundColor="Transparent"/>
                </Frame>

                <!-- EMAIL -->
                <Label Text="Email"
                       FontAttributes="Bold"/>

                <Frame BorderColor="#DDDDDD"
                       CornerRadius="15"
                       Padding="10"
                       HasShadow="False">

                    <Entry Placeholder="Enter email"
                           Keyboard="Email"
                           BackgroundColor="Transparent"/>
                </Frame>

                <!-- PASSWORD -->
                <Label Text="Password"
                       FontAttributes="Bold"/>

                <Frame BorderColor="#DDDDDD"
                       CornerRadius="15"
                       Padding="10"
                       HasShadow="False">

                    <Entry Placeholder="Enter password"
                           IsPassword="True"
                           BackgroundColor="Transparent"/>
                </Frame>

                <!-- SIGNUP BUTTON -->
                <Button Text="Create Account"
                        HeightRequest="55"
                        BackgroundColor="#228B22"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="15"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>