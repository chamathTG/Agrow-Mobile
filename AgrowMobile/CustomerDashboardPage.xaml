<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:AgrowMobile.Models"
    x:Class="AgrowMobile.CustomerDashboardPage"
    BackgroundColor="White">

    <ContentPage.ToolbarItems>

        <ToolbarItem Text="Cart"
                     Clicked="OnCartClicked"/>

    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- TOP -->
        <VerticalStackLayout Padding="20"
                             Spacing="10">

            <Label x:Name="CustomerNameLabel"
                   Text="Welcome Customer"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#228B22"/>

            <Label Text="Available Products"
                   FontSize="20"
                   FontAttributes="Bold"/>

        </VerticalStackLayout>

        <!-- PRODUCTS -->
        <CollectionView Grid.Row="1"
                        x:Name="ProductsCollection"
                        Margin="20,0">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="model:ProductModel">

                    <Frame Margin="0,10"
                           Padding="10"
                           BorderColor="#DDDDDD">

                        <VerticalStackLayout Spacing="10">

                            <Image Source="{Binding Image}"
                                   HeightRequest="180"
                                   Aspect="AspectFill"/>

                            <Label Text="{Binding Title}"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <Label Text="{Binding Description}"/>

                            <Label Text="{Binding Qty,
                                   StringFormat='Available Qty: {0}'}"/>

                            <Label Text="{Binding Price,
                                   StringFormat='Price: Rs. {0:F2}'}"
                                   FontAttributes="Bold"
                                   TextColor="Green"/>

                            <Button Text="Buy Product"
                                    BackgroundColor="#228B22"
                                    TextColor="White"
                                    Clicked="OnBuyClicked"
                                    CommandParameter="{Binding Id}"/>

                            <Button Text="Add To Cart"
                                    BackgroundColor="Orange"
                                    TextColor="White"
                                    Clicked="OnAddToCartClicked"
                                    CommandParameter="{Binding Id}"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>